PORT=3001

# MongoDB (Atlas in production, or local / docker-compose mongo)
MONGODB_URI=mongodb://flowgen:flowgen_dev@localhost:27017/flowgen?authSource=admin

# Redis: local Docker → redis://localhost:6379 (no TLS)
# Production Upstash → rediss://default:...@...upstash.io:6379 (TLS auto-enabled from rediss://)
REDIS_URL=redis://localhost:6379

# Optional: force TLS on/off (defaults: rediss:// → TLS on, redis:// → TLS off)
# REDIS_TLS=true

AUTH0_ISSUER=
AUTH0_AUDIENCE=
GROQ_API_KEY=
GEMINI_API_KEY=
YOUTUBE_API_KEY=
BASE_URL=https://youtube.googleapis.com/youtube/v3
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:3000
START_WORKER=true
