# Copy to ".env" in this repo root (same folder as docker-compose.yml).
# Docker Compose loads it automatically for variable substitution into the backend service.

AUTH0_ISSUER=https://your-auth0-domain/
AUTH0_AUDIENCE=your-api-identifier
GROQ_API_KEY=
YOUTUBE_API_KEY=
BASE_URL=https://youtube.googleapis.com/youtube/v3
JWT_SECRET=

# Optional: override compose defaults for Mongo root user/password
# MONGO_INITDB_ROOT_USERNAME=flowgen
# MONGO_INITDB_ROOT_PASSWORD=flowgen_dev
